{
    "name": "pdfkiln/pdfkiln",
    "description": "Drop-in replacement for wkhtmltopdf, powered by Chromium: vendor/bin/wkhtmltopdf and vendor/bin/wkhtmltoimage, downloaded on first use",
    "type": "library",
    "keywords": [
        "wkhtmltopdf",
        "wkhtmltoimage",
        "pdf",
        "chromium"
    ],
    "homepage": "https://github.com/Jamalofski/pdfkiln",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "src/launch.php"
        ]
    },
    "bin": [
        "bin/wkhtmltopdf",
        "bin/wkhtmltoimage",
        "bin/pdfkiln"
    ]
}
